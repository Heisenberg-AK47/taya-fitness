{
    "rewrites": [
          { "source": "/programmes",       "destination": "/programmes.html" },
          { "source": "/programme-detail", "destination": "/programme-detail.html" },
          { "source": "/offres",           "destination": "/offres.html" },
          { "source": "/panier",           "destination": "/panier.html" },
          { "source": "/checkout",         "destination": "/checkout.html" },
          { "source": "/auth",             "destination": "/auth.html" },
          { "source": "/dashboard",        "destination": "/dashboard.html" },
          { "source": "/contact",          "destination": "/contact.html" },
          { "source": "/reservation",      "destination": "/reservation.html" },
          { "source": "/admin",            "destination": "/admin.html" },
          { "source": "/crm",              "destination": "/crm.html" }
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
          {
                  "source": "/(.*)",
                  "headers": [
                            { "key": "X-Content-Type-Options", "value": "nosniff" },
                            { "key": "X-Frame-Options",        "value": "DENY" },
                            { "key": "X-XSS-Protection",       "value": "1; mode=block" }
                  ]
          }
    ]
}
